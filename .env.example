# Database Configuration
DATABASE_URL=postgresql://lunt_user:lunt_pass@localhost:5432/lunt_db
POSTGRES_USER=lunt_user
POSTGRES_PASSWORD=lunt_pass
POSTGRES_DB=lunt_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
API_TITLE=Lunt API
API_DESCRIPTION=Sistema inteligente de analisis y gestion de costos de construccion

# Default Location
DEFAULT_LOCATION_CODE=MX-CDMX

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lunt-data
MINIO_SECURE=false

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=concepts

# JWT Configuration
# WARNING: Change JWT_SECRET_KEY in production! Use a strong random string (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=***CHANGE_ME_IN_PRODUCTION***
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS Configuration
# WARNING: In production, set ALLOWED_ORIGINS to your exact domains only
# Example: ALLOWED_ORIGINS=https://app.lunt.com,https://www.lunt.com
# For development, localhost is allowed by default
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rate Limiting Configuration
# Format: "count/period" where period can be: second, minute, hour, day
# Example: "100/minute" means 100 requests per minute per IP
# WARNING: Adjust based on your expected traffic. Too low may block legitimate users
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_ENABLED=true

# Metabase Configuration
METABASE_PORT=3001

# Environment
ENVIRONMENT=development
DEBUG=true

# Pricing Configuration (p1.3)
# Fracciones [0,1]
LUNT_DEFAULT_PORC_INDIRECTOS=0.10
LUNT_DEFAULT_PORC_UTILIDAD=0.10

# NL Resolver (3.x)
NL_RESOLVER_BACKEND=qdrant
NL_QDRANT_URL=http://localhost:6333
NL_QDRANT_API_KEY=
NL_QDRANT_COLLECTION=concepts_v1
NL_EMBED_MODEL=torch-mini-emb-384
NL_EMBED_DIM=384
NL_TOPK=5
NL_TOPK_ALT=5
NL_SCORE_THRESHOLD=0.72
NL_NORMALIZE_SCORES=true
NL_ENABLE_CACHE=true
NL_CACHE_TTL_SEC=3600
NL_LANG_DEFAULT=es
